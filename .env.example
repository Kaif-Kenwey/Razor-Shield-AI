# RazorShield AI — environment configuration
DATABASE_URL="file:../db/custom.db"

# ---------------------------------------------------------------------------
# LLM investigator (OPTIONAL — the app is fully usable without it)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works. Priority order:
#   1. In-app AI panel config (top bar "AI" button) — stored server-side in
#      db/llm-config.json (gitignored), never sent to the browser
#   2. These environment variables (infra-managed deployments)
#   3. Deterministic heuristic investigator (always available fallback)
#
# Providers with in-app selectors: OpenRouter, Google Gemini (OpenAI-compatible
# endpoint), Groq, Ollama (local, no key), or any custom endpoint.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional extra headers required by some corporate gateways:
# LLM_EXTRA_HEADERS={"X-Token":"..."}
#
# Automatic free-model routing (in-app only): pick "Automatic Free Model" in
# the AI panel — the server resolves it to a currently-$0 model from
# OpenRouter's live catalogue. No variable needed.
#
# Example: local Ollama (nothing leaves the machine)
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama-local
#   LLM_MODEL=llama3.2

# NOTE: there is NO real payment gateway. Transactions reach the ledger via
# CSV import (Dataset Studio), manual entry, or the labelled DEMO SIMULATION
# generator — all clearly identified in the UI.
