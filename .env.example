# RazorShield AI — environment configuration
DATABASE_URL="file:../db/custom.db"

# LLM investigator (optional). Any OpenAI-compatible chat-completions
# endpoint works — e.g. https://api.openai.com/v1 with an OpenAI key,
# a Groq/Together endpoint, or a local Ollama/vLLM server.
# When unset, investigations fall back to the deterministic heuristic
# engine and the UI labels the analysis accordingly.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional extra headers required by some corporate gateways:
# LLM_EXTRA_HEADERS={"X-Token":"..."}
